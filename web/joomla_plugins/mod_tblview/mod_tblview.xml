<?xml version="1.0" encoding="utf-8"?>
<extension
	type="module"
	version="2.5"
	client="site"
	method="upgrade">
	<name>mod_tblview</name>
	<author>Samba Godschynski</author>
	<creationDate>January 2013</creationDate>
	<copyright>Copyright (C) 2005 - 2012 Open Source Matters. All rights reserved.</copyright>
	<license>GNU General Public License version 2 or later; see LICENSE.txt</license>
	<authorEmail>samba.godschynski@gmail.com</authorEmail>
	<authorUrl>www.vstforx.de</authorUrl>
	<version>2.5.0</version>
	<description>Shows SQL query as table</description>
	<files>
		<filename module="mod_tblview">mod_tblview.php</filename>
		<filename>index.html</filename>		
		<filename>mod_tblview.xml</filename>
	</files>
	<languages>
	</languages>
	<config>
	  <fields name="params">
	    <fieldset name="basic">
	      <field
		  name="query"
		  type="textarea"
		  default=""
		  label="QUERY"
		  description="the sql query"
		  cols="50"
		  rows="10">
	      </field>
	      <field
		  name="tbl_class"
		  type="text"
		  default=""
		  label="table class"
		  description="the html table class name">
	      </field>
	    </fieldset>
	  </fields>
	</config>
</extension>
