class MainView
!!!191052.cpp!!!	MainView(inout size : CRect, inout pSystemWindow : void, inout pEditor : void)

	contextMenu = new CMenu ( this );
	toolBx = new MToolBox ( this );
!!!191180.cpp!!!	mouse(inout cc : CDrawContext, inout p : CPoint, in btn : long) : void

	btn = cc->getMouseButtons();
	if ( btn == kLButton ) {
		if ( !contextMenu->hitTest( p ) && contextMenu->isVisible() ){ 
			contextMenu->hide();
			setDirty();
		}
	}
	
	if ( btn == kRButton ){ // rechter Mausbutton
		if ( contextMenu->isVisible() ) contextMenu->hide();
		CircuidView *view;
		if (  ! (view = dynamic_cast<CircuidView*> ( getViewAt(p) ) ) ) return;
		contextMenu->addMenuEntryList ( view->getMenuEntryListAt (p) );
		contextMenu->showAt (p);
		setDirty();
		return;
	}

	CFrame::mouse ( cc, p, btn );
!!!191308.cpp!!!	~MainView()

	delete contextMenu;
	delete toolBx;
!!!191436.cpp!!!	update(inout cc : CDrawContext) : void

	CFrame::update ( cc );
	CPoint p;
	cc->getMouseLocation(p);
	MouseMotionListenerList::iterator it = mMotionListeners.begin();
	for ( ;it!=mMotionListeners.end(); it++ ) (*it)->mouseMoveEventHandler ( cc, p );
