class ViewRelations
!!!179020.cpp!!!	load(inout ar : iArchive, in version : uint) : void

	v2m->clear();
	map<long, V*> tmp;
	ar>>tmp;
	map<long, V*>::iterator it = tmp.begin();
	for ( ; it!=tmp.end(); ++it ){
		U *uObj = (U*) (*it).first;
		V *vObj = (*it).second;
		v2m->insert ( pair<U*, V*> ( uObj, vObj ) );
	}
!!!179148.cpp!!!	save(inout ar : oArchive, in version : uint) : void

	// U zeiger nicht direkt serialisieren da view evntl. geschlossen.
	map<long, V*> tmp;
	V2M::iterator it = v2m->begin();
	for ( ; it!=v2m->end(); ++it ){
		long ptr = (long)(*it).first;
		V *obj = (*it).second;
		tmp.insert ( pair<long, V*> ( ptr, obj ) );
	}
	ar<<tmp;
!!!179660.cpp!!!	registerRelation(inout vObj : U, inout mObj : ViewRelations::V) : void

	assert (vObj);
	if ( !vObj ) return;
	pair < V2M::iterator, bool > ret = v2m->insert ( pair<U*, V*> ( vObj, mObj ) );
	assert ( ret.second );
!!!179788.cpp!!!	unregisterRelation(inout vObj : U, inout mObj : ViewRelations::V) : void

	V2M::iterator it = v2m->find(vObj);
	assert ( it != v2m->end() );
	v2m->erase(it);
!!!180044.cpp!!!	saveViewRelation(inout ar : oArchive) : void

	V2M::const_iterator it = v2m->begin();
	list<U*> l;
	for ( ; it!=v2m->end(); ++it ){
		if ( dynamic_cast<Serializable*> ( (*it).first ) )
			l.push_back ( (*it).first );
	}
	ar << l;
!!!180172.cpp!!!	loadViewRelation(inout ar : iArchive) : void

	list<U*> l;
	ar >> l;
	assert ( l.size() == v2m->size() ); // datenstruktur darf sich waehrend view closed nicht geandert haben.
	V2M *neuV2M = new V2M();
	list<U*>::iterator it = l.begin();
	V2M::iterator it2 = v2m->begin();
	for ( ; it!=l.end(); ++it ){
		U *u = *it;
		V *v = (*it2++).second;
		neuV2M->insert ( pair<U*, V*> ( u, v ) );
	}
	delete v2m;
	v2m = neuV2M;
