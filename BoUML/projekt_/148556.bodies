class GOutputNode
!!!167756.cpp!!!	GOutputNode(inout parent : CircuidView, in skinResID : long)

	skin = new CBitmap (skinResID);
	bBox = CRect ( 0,0, skin->getWidth(), skin->getHeight() );
	focus = CPoint ( skin->getWidth()>>1, skin->getHeight()>>1 );
	radius = skin->getWidth()>>1;
	name = "Output_Node";
	//ConnectionNode verschieben
	focus = CPoint (bBox.width()>>1, bBox.height()>>1);
!!!168012.cpp!!!	~GOutputNode()

	delete skin;
