class CmdPlaceGKnob
!!!210252.cpp!!!	_execute() : void

	CPoint point;
	cView->getMouseLocation (point);
	Graph *graph = getRelatedGraph (cView);
	GKnob *knob = new GStdKnob ( cView );
	knob->setHeader ( param->getName() );
	knob->setDisplay ( param->getDisplay() );
	knob->setValue ( *param );
	ctrl->registerObject ( knob, param );
	knob->moveTo (point);
	GConnection *gc = new GConnectionPrPa ( cView, knob, gObj );
	ctrl->registerObject ( gc );
	cView->addGObject ( (GObject*)gc, CircuidView::CONNECTIONS);
	PlaceGObject *pC = new PlaceGObject( cView, knob );
	cView->addGObject ( pC );
	cView->setDirty(knob);
