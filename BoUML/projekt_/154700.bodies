class GKnobConnectionController
!!!187212.cpp!!!	registerObject(inout gObj : GObject, inout pObj : PObject) : void

!!!187340.cpp!!!	unregisterObject(inout gObj : GObject, inout pObj : PObject) : void

	if ( !dynamic_cast<GConnectionPaPa*>( gObj ) ) return;
	GConnection *gc = static_cast<GConnection*>( gObj );
	// Hole GObjects ...
	GObject *knA = gc->getObjectA();
	GObject *knB = gc->getObjectB();
	// ... und PObjects 
	Parameter *pA = frntCtrl.getViewRelations().get<Parameter> ( knA );
	Parameter *pB = frntCtrl.getViewRelations().get<Parameter> ( knB );
	if ( pA && pB ) pA->removeBiConnection ( pB );
!!!187468.cpp!!!	getMenuEntryList(inout obj : GObject, inout mL : MenuEntryList) : void

	// parameter a und b holen
	GConnectionPaPa *gc = dynamic_cast<GConnectionPaPa*> ( obj );
	if (!gc) return;
	Parameter *a = frntCtrl.getViewRelations().get<Parameter>( gc->getObjectA() );
	Parameter *b = frntCtrl.getViewRelations().get<Parameter>( gc->getObjectB() );
	if ( !a || !b ) throw com::ppiError::MapError ( "object not found.", __FILE__, __LINE__ );
	CircuidView *view = obj->getParentView();
	ADD_MENU_TITLE ( mL, a->getName() + " to " + b->getName() );
	ADD_MENU_LABEL ( mL, "add +/- operator", 
		new CmdAddConnectionOperator<parameter::InverseConnection> (a,b, view ) ); 
	ADD_MENU_LABEL ( mL, "add EXP/LOG operator", 
		new CmdAddConnectionOperator<parameter::ExpConnection> (a,b, view ) ); 
	ADD_MENU_LABEL ( mL, "add LOG/EXP operator", 
		new CmdAddConnectionOperator<parameter::LogConnection> (a,b, view ) ); 
	ADD_MENU_LABEL ( mL, "remove connection", new CmdRemoveGObject( view, gc ) ); 
	ConnectionOperator::SPtrContainer l = a->getConnectionOperatorContainer(b);
	ConnectionOperator::SPtrContainer::iterator it = l.begin();
	MenuEntryList aMl;
	ADD_MENU_TITLE ( aMl, "operator parameter:" );
	for ( ; it!=l.end(); ++it ){
		HasParameter *hP = dynamic_cast <HasParameter*> ( (*it).get() );
		if (!hP) continue;
		hasParameterToMenuEntryList ( hP, aMl, obj, &frntCtrl, 0 );
	}
	if ( aMl.size() > 1 ) mL.splice (  mL.end(), aMl );

