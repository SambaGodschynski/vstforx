class CmdCreateGVSTPlugNode
!!!207436.cpp!!!	_execute() : void

	Graph *graph = getRelatedGraph ( cView );
	CPoint point; cView->getMouseLocation (point);
	// datei namen auswaehlen
	string filename = CircuidControl::selectFile ();
	if (filename.length()==0) return;
	// erstelle VSTPlugNode
	VSTPlugNode *plug = NULL;
	try {
		plug = new VSTPlugNode( filename );
	} catch (...){
		cView->CView::setDirty();
		return;
	}
	graph->addCommand ( Command::Ptr ( new GCmdAddPObject ( graph, plug ) ) );
	// erstelle GVSTPlugNode
	GProcessorNode::InputNodeContainer ins;
	GProcessorNode::OutputNodeContainer outs;
	GVSTPlugNode *gPlug = new GVSTPlugNode ( cView );
	gPlug->setName ( plug->getPlugName() );
	gPlug->moveTo (point);
	gPlug->createIONodes( 1, 1, ins, outs );
	ctrl->registerObject ( gPlug, plug );
	// Eingangsknoten
	GInputNode  *in = ins.at(0);
	in->setName (filename+"::input");
	ctrl->registerObject ( in, plug );
	// Ausgangsknoten
	GOutputNode *out = outs.at(0);
	out->setName (filename+"::output");
	ctrl->registerObject ( out, plug );
	// fuege GVSTPlugNode der view hinzu
	cView->addGObject ( gPlug );
	list<GConnection*> l;
	gPlug->addIONodesOnView( ins, outs, l );
	// connections registr.
	for ( list<GConnection*>::iterator it = l.begin(); it!=l.end(); ++it ) {
		ctrl->registerObject ( *it );
	}
	cView->CView::setDirty();
