class CmdAddStepNodeOutput
!!!210508.cpp!!!	_execute() : void

	// StepAdapter holen:
	StepAdapter *sa = ctrl->getViewRelations().get<StepAdapter> (vObj);
	PObject * newNode = sa->addStepNode();
	if (!newNode) throw com::ppiError::SizeError ("max. steps reached", __FILE__, __LINE__ );
	// output node erstellen...
	CPoint point;
	cView->getMouseLocation (point);
	GOutputNode *newGNode = new GOutputNode ( cView, RESOURCE.VSTPLUG_OUTPUT );
	//gobject registrieren
	ctrl->registerObject ( newGNode, newNode );
	newGNode->moveTo (point);
	newGNode->setName ("Step node GOutput");
	// ...connection...
	GConnection *gc = new GConnectionPrOut ( cView, newGNode,  vObj );
	cView->addGObject ( (GObject*)gc, CircuidView::CONNECTIONS);
	// ... und platzieren
	PlaceGObject *pC = new PlaceGObject( cView, newGNode );
	cView->addGObject ( pC );
	cView->setDirty(newGNode);
