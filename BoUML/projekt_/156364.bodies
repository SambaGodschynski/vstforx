class MToolBox
!!!190668.cpp!!!	MToolBox(inout frame : CFrame)

	views = new CView*[tNum];
	//--------------------------------------------------------
	// Background
	CBitmap *bmp = new CBitmap ( RESOURCE.TLBX_BK );
	CRect size ( 0, 0, bmp->getWidth(), bmp->getHeight() );
	size.offset( 1, 0 );
	setViewSize (size);
	setMouseableArea(size);
	setBackground ( bmp );
	bmp->forget();
	frame->addView ( this );
	//--------------------------------------------------------
	// Use Btn
	bmp = new CBitmap ( RESOURCE.TLBX_BTN_USE );
	size = CRect( 0, 0, bmp->getWidth(), bmp->getHeight()/2 );
	size.offset( 2, 1 );
	views[tBtnUse] = new CMovieButton ( size, this, tBtnUse, bmp->getHeight()/2, bmp, CPoint() );
	bmp->forget();
	( (CControl*)views[tBtnUse] )->setValue ( 1.0f );
	frame->addView ( views[tBtnUse] );
	//--------------------------------------------------------
	// Connect Btn
	bmp = new CBitmap ( RESOURCE.TLBX_BTN_CNT );
	size.offset( 24, 0 );
	views[tBtnConnect] = new CMovieButton ( size, this, tBtnConnect,  bmp->getHeight()/2, bmp, CPoint() );
	bmp->forget();
	frame->addView ( views[tBtnConnect] );
	//--------------------------------------------------------
	// Move Btn
	bmp = new CBitmap ( RESOURCE.TLBX_BTN_MOVE );
	size.offset( 24, 0 );
	views[tBtnMove] = new CMovieButton ( size, this, tBtnMove,  bmp->getHeight()/2, bmp, CPoint() );
	bmp->forget();
	frame->addView ( views[tBtnMove] );
!!!190924.cpp!!!	~MToolBox()

	for (int i=0; i<tNum; i++) delete views[i];
	delete views;
