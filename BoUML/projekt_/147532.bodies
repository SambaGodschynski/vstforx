class GButton
!!!177356.cpp!!!	valueChanged(inout cc : CDrawContext, inout pControl : CControl) : void

	setObjectDirty();
	EventSender<ButtonClicked>::notifyEventListeners ( this, ButtonClicked ( this ) );
!!!177484.cpp!!!	GButton(inout parent : CircuidView, inout btn : CMovieButton)
 
	name = "Button";
!!!177740.cpp!!!	~GButton()

!!!177868.cpp!!!	createNewEditButton(inout view : CircuidView) : GButton

	CBitmap *bmp = new CBitmap ( RESOURCE.EDIT_BUTTON );
	CRect size ( 0, 0, bmp->getWidth(), bmp->getHeight() / 2 );
	CMovieButton *btn = new CMovieButton ( size, NULL, 0, bmp->getHeight() / 2, bmp, CPoint() );
	GButton *neu = new GButton( view, btn );
	neu->setRadius(15);
	btn->setListener ( neu );
	bmp->forget();
	return neu;
