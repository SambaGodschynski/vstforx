class GObject
!!!197324.cpp!!!	save(inout ar : oArchive, in version : uint) : void

	ar << name;
	ar << description;
	CPoint pos = getPos();
	ar << pos.x;
	ar << pos.y;
	ar << zPos;
!!!197452.cpp!!!	load(inout ar : iArchive, in version : uint) : void

	ar >> name;
	ar >> description;
	CPoint pos;
	ar >> pos.x;
	ar >> pos.y;
	ar >> zPos;
	moveTo ( pos );
!!!197708.cpp!!!	~GObject()

	EventSender< OnDestroy<GObject> >::notifyEventListeners ( this, OnDestroy<GObject>( this ) );
	for ( int i=0; i<subObjects.size(); i++ ) delete subObjects[i];
!!!199628.cpp!!!	setObjectDirty() : void

	parentView->setDirty ( this );
