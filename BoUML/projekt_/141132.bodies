class CMenu
!!!156748.cpp!!!	_hide() : void

	MenuEntryList::iterator it = menuEntries.begin();
	for (; it!=menuEntries.end(); ++it) {
		(*it)->EventSender<OnMouseClick>::removeEventListener ( this );
		CSubMenuEntry *sub = dynamic_cast <CSubMenuEntry*> ( (*it).get() );
		if ( sub ) {
			sub->EventSender<OnMouseEnter>::removeEventListener ( &subMenuListener );
			sub->EventSender<OnMouseLeave>::removeEventListener ( &subMenuListener );
		}
	}
	void *ptr = this;
	visible = false;
	hold = false;
	entr_offset = 0;
	clearEntries();
	scroller = nullEntry;
	( (PpiEditor*)getFrame()->getEditor() )->removeIdleListener ( this );
	getFrame()->setFocusView ( this );
	getFrame()->removeView ( this, false );
	getFrame()->setDirty();
!!!156876.cpp!!!	calcSize(inout point : CPoint) : void

	MenuEntryList::iterator it = menuEntries.begin();
	int i=0; //entr_offset cnt 
	int n=0; //max entrie cnt
	CRect tmp;
	tmp.setWidth ( 85 ); // minimale breite
	for ( ; it!=menuEntries.end(); ++it ) {
		if ( i++ < entr_offset ) continue; // ueberspringe eintraege < offset
		CView *view = (*it).get();
		if ( tmp.width() < view->getWidth() ) tmp.setWidth ( view->getWidth() ); // akt. max. breite
		// addiere Hoehe wenn maxEntries noch nicht erreicht.
		if ( n++ <= maxEntries ) tmp.setHeight ( view->getHeight() + tmp.height() + 1 );
	}
	tmp.offset ( point.x - tmp.x, point.y - tmp.y ); // bewege nach point
	tmp.setHeight ( tmp.getHeight() + scroller->getHeight() ); 
	setViewSize (tmp);
	setMouseableArea (tmp);
!!!157132.cpp!!!	drawFrame(inout cc : CDrawContext, inout size : CRect) : void

	cc->setLineStyle ( kLineSolid );
	cc->setLineWidth ( 1 );
	cc->setFrameColor ( ppiGui::black );
	cc->setFillColor ( ppiGui::alphaGrey );
	cc->fillRect ( size );
	cc->drawRect ( size );
!!!157260.cpp!!!	CMenu(inout frame : CFrame)

	CView::pParentFrame = frame;
	entr_offset = 0;
	visible = false;
	scrollSwitch = new CMenuScrollSwitch( this );
	nullEntry = new CNullEntry();
	subMenuListener.parent = this;
!!!157516.cpp!!!	create(inout frame : CFrame) : CMenu::Ptr

	CMenu::Ptr _new ( new CMenu ( frame ) );
	_new->self = _new;
	return _new;
!!!157644.cpp!!!	~CMenu()

	hide();
	delete scrollSwitch;
	delete nullEntry;
!!!157772.cpp!!!	draw(inout cc : CDrawContext) : void

	if (!visible) return;
	drawFrame ( cc, size );
	drawEntries ( cc );
	setDirty(false);
!!!158028.cpp!!!	hide() : void
 
	CMenu::Ptr toRemove = self.lock();
	if ( toRemove )
		( (PpiEditor*)getFrame()->getEditor() )->addCommand ( Command::Ptr (new RemoveMenu(toRemove) ) );
!!!158668.cpp!!!	moveTo(inout p : CPoint) : void

	CRect tmp;
	getViewSize ( tmp );
	tmp.offset ( p.x - size.x, p.y - size.y );
	setViewSize ( tmp );
	setMouseableArea ( tmp );
!!!158796.cpp!!!	clearEntries() : void

	MenuEntryList::iterator it = menuEntries.begin();
	while ( it!=menuEntries.end() ) {
		it = menuEntries.erase( it );
	}
	assert ( menuEntries.empty() );
	size = CRect(0,0,0,0);
	this->setMouseableArea ( size );
!!!158924.cpp!!!	addMenuEntry(in entry : MenuEntryPtr) : void
 
	menuEntries.push_back ( entry );
    entr_offset = 0;
!!!159052.cpp!!!	addMenuEntryList(inout list : MenuEntryList) : void

	MenuEntryList::iterator it = list.begin();
	for ( ; it!=list.end(); ++it ) {
		addMenuEntry (*it);
	}
!!!159308.cpp!!!	onIdle() : void

	if ( hold ) return;
	boost::scoped_ptr<CDrawContext> cD ( getFrame()->createDrawContext() );
	cD->getMouseLocation( currMousePos );
	CRect tmp; getViewSize(tmp);
	tmp.inset ( -50, -50 );
	ClockEdge::EdgeValue trigger = focusTrigger.in ( tmp.pointInside ( currMousePos ) );
	// OnEnter, OnLeave events:
	switch ( trigger ) {
		case ClockEdge::HIGH :
			EventSender<OnMouseEnter>::notifyEventListeners ( this, OnMouseEnter( NULL, cD.get(), currMousePos, -1 ) );
			break;
		case ClockEdge::LOW  :
			EventSender<OnMouseLeave>::notifyEventListeners ( this, OnMouseLeave( NULL, cD.get(), currMousePos, -1 ) );
			break;
	}
	setDirty();
!!!159436.cpp!!!	scrollDwn() : void

	int c =  ( menuEntries.size()-1 ) - maxEntries;
	if ( entr_offset  < c ) {
		entr_offset++;
	}
	setDirty();
!!!159564.cpp!!!	scrollUp() : void

	if ( entr_offset > 0 ) {
		entr_offset--;
	}
	setDirty();
!!!159820.cpp!!!	eventHandler(inout src : void, in ev : OnMouseClick) : void

	CMenuEntry *m = (CMenuEntry*) src;
	Command::Ptr cmd = m->getAction();
	hide();
	cmd->execute();
	EventSender<OnMouseClick>::notifyEventListeners ( this, ev );
	getFrame()->setDirty();
