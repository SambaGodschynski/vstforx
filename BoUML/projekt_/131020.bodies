class Graph
!!!227660.cpp!!!	checkActivity(inout node : ProcessorNode) : bool

	if ( node == startNode ) return true;
	for ( size_t i=0; i<node->parents.size(); i++ ){
		if ( checkActivity(node->parents[i]) ) {
			node->setActive (true);
			node->parents[i]->activeChilds++;
		}
	}
	return node->active;
!!!227788.cpp!!!	executeCommands() : void

	Command::Container::iterator it = cmdList.begin();
	for (; it!=cmdList.end(); ++it){
		(*it)->execute();
	}
	cmdList.clear();
	updateGraph();
!!!227916.cpp!!!	addNode(inout node : ProcessorNode) : void

	nodes.push_back ( node );
!!!228044.cpp!!!	removeNode(inout node : ProcessorNode) : void

	//child relationen akualisieren
	ProcessorNode::Container::iterator it1 = node->getChilds().begin();
	while ( it1 != node->getChilds().end() ){
		(*it1)->removeParent (node);
		++it1;
	}
	//parent relationen akualisieren
	it1 = node->getParents().begin();
	while ( it1 != node->getParents().end() ){
		(*it1)->removeChild(node);
		++it1;
	}
	//Knoten aus map entfernen
	nodes.remove ( node );
!!!228172.cpp!!!	initHostParameter() : void

	for ( int i=0; i<com::Settings::PROGRAM_PARAMETER; ++i ){
		Parameter *p = new parameter::Parameter (i);
		p->setName ( "host parameter " + MyString(i) );
		hostParameter.push_back (p);
		add( p );
	}
!!!228940.cpp!!!	Graph(inout parent : AudioEffectX)

	startNode = new StartNode ();
	endNode = new EndNode ();
	add ( startNode );
	add ( endNode );
	initHostParameter();
!!!229068.cpp!!!	getStartNode() : ProcessorNode

	return startNode;
!!!229196.cpp!!!	getEndNode() : ProcessorNode

	return endNode;
!!!229324.cpp!!!	processGraph() : Frame

	Frame *fr = NULL;
	if ( endNode->isActive() ) fr = endNode->popFrame();
	//sind Graph Veraendernde befehle auszufuehren?
	if ( !cmdList.empty() ) executeCommands(); // dann bitte jetzt.
	return fr;
!!!229452.cpp!!!	pushFrame(inout fr : Frame) : void

	if (!endNode->isActive()) return;
	startNode->pushFrame ( fr );
!!!229580.cpp!!!	addCommand(in cmd : Command::Ptr) : void

	cmdList.push_back ( cmd );
!!!229708.cpp!!!	contains(inout obj : PObject) : bool

	if ( com::contains < GraphObjectContainer, PObject* > ( graphObjects, obj ) ) return true;
	return false;
!!!229836.cpp!!!	createParameter() : Parameter

	Parameter *p = new Parameter();
	graphObjects.push_back (p);
	createdParameter++;
	return p;
!!!229964.cpp!!!	removeParameter(inout p : Parameter) : void

	graphObjects.remove( p );
!!!230092.cpp!!!	add(inout obj : PObject) : void

	if ( contains(obj) ) return;
	ProcessorNode *node = dynamic_cast <ProcessorNode*> (obj);
	if (node) addNode( node );
	graphObjects.push_back (obj);
!!!230220.cpp!!!	remove(inout obj : PObject) : bool

	if ( !contains(obj) ) return false;
	ProcessorNode *node = dynamic_cast <ProcessorNode*> (obj);
	if (node) removeNode( node );
	graphObjects.remove (obj);
	return true;
!!!230348.cpp!!!	updateGraph() : void

	// setzte alle Nodes auf active = false 
	// und activeChilds wert auf 0.
	NodeBuffer::iterator it = nodes.begin();
	for ( ; it!=nodes.end(); ++it ){
		if ( (*it) == startNode ) (*it)->active = true;
		else (*it)->active = false;	
	}
	checkActivity(endNode); // rekursive methode!
	it = nodes.begin();
	for ( ; it!=nodes.end(); ++it ){ // TODO: laesst sich bestimmt noch in checkActivity einbauen.
		(*it)->activeChilds = (*it)->__getNumActiveChilds__();
	}
!!!230476.cpp!!!	hostInfoChanged() : void

	NodeBuffer::iterator it = nodes.begin();
	for ( ; it!=nodes.end(); ++it ){
		(*it)->hostInfoChanged();
	}
!!!230604.cpp!!!	connectNodes(inout output : ProcessorNode, inout input : ProcessorNode) : bool

	if ( !contains(output) || !contains(input) ) return false; 
	return output->addChild(input) && input->addParent(output);
!!!230732.cpp!!!	removeConnection(inout a : ProcessorNode, inout b : ProcessorNode) : bool

	return a->removeChild(b) && b->removeParent(a);
!!!230988.cpp!!!	~Graph()

	try {
		//loesche alle graph objekte
		GraphObjectContainer::iterator it = graphObjects.begin();
		for (; it!=graphObjects.end(); ++it) {
			delete *it;
		}
		//release alle modulehandler
		set<ModuleHandler>::iterator it2 = loadedModules.begin();
		for ( ; it2!=loadedModules.end(); ++it2 ) {
			FreeLibrary  ( *it2 );
		}
	} catch ( ... ) {
		throw com::ppiError::PPIError ( "Exception!" , __FILE__, __LINE__ );
	}
!!!231116.cpp!!!	save(inout ar : oArchive) : void

	ar << this;
	// serialisierbare objekte sammeln:
	list < PObject* > objs;
	GraphObjectContainer::iterator it = graphObjects.begin();
	for ( ; it != graphObjects.end(); ++it ){ // druchlaufe alle GObjects auf der View
		Serializable *obj = dynamic_cast <Serializable*>(*it);
		if (!obj) continue;
		objs.push_back (*it);
	}
	// serialisieren:
	ar<<objs;
	// hostParameter
	ar<<hostParameter;
!!!231244.cpp!!!	load(inout ar : iArchive, inout eff : AudioEffectX) : Graph

	Graph *g;
	ar >> g; g->parentEffect = eff;
	// serialisieren:
	list < PObject* > objs;
	ar>>objs;
	list < PObject*>::iterator it = objs.begin();
	for ( ;it!=objs.end(); ++it ){
		g->add ( *it );
		if ( dynamic_cast<ProcessAdapter*> ( *it ) ) {
			( (ProcessAdapter*)*it )->setGraph ( g );
		}
	}
	// hostParameter
	ar>>g->hostParameter;
	// ...
	g->updateGraph();
	return g;
