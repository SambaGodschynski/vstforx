class GVSTPlugNode
!!!166476.cpp!!!	GVSTPlugNode(inout parent : CircuidView)

	name = "unkown VstPlugNode";
	skin = new CBitmap (RESOURCE.VSTPLUG_NODE);
	bBox = CRect ( 0,0, skin->getWidth(), skin->getHeight() );
	focus = CPoint ( skin->getWidth()>>1, skin->getHeight()>>1 );
	radius = skin->getWidth()>>1;
	focus = CPoint (bBox.width()>>1, bBox.height()>>1);
	// EditButton erzeugen und zu subObjects hinzufügen.
	GButton *edit = GButton::createNewEditButton ( parent );
	edit->moveTo ( CPoint ( ( skin->getWidth()>>1 ) + 1, 
		                    skin->getHeight() -  10 ) );
	subObjects.push_back ( edit );
	edit->EventSender<ButtonClicked>::addEventListener ( this );
!!!166732.cpp!!!	~GVSTPlugNode()

	delete skin;
