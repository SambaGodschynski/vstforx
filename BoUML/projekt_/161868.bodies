class CmdCreateHostGKnob
!!!209996.cpp!!!	_execute() : void

	Graph *graph = getRelatedGraph ( cView );
	CPoint point;
	cView->getMouseLocation (point);
	Parameter *p = graph->getHostParameter (index);
	GKnob *knob = new GStdKnob ( cView );
	ctrl->registerObject ( knob, p );
	knob->moveTo ( point );
	knob->setHeader ( p->getName() );
	knob->setDisplay( p->getDisplay() );
	cView->addGObject ( knob );
	cView->setDirty(knob);
