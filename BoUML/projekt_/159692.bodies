class CViewWrapper
!!!204876.cpp!!!	CViewWrapper(inout parent : CircuidView, inout cView : CView)

	cView->getViewSize( bBox );
	focus = CPoint ( bBox.x + bBox.width()>>1, bBox.y + bBox.height()>>1 );
	GCView *hack = (GCView*) (cView);
	hack->setFrame ( parent->getFrame() );
	assert ( cView->getFrame() == parent->getFrame() );
!!!205388.cpp!!!	~CViewWrapper()

	parentView->getFrame()->removeView ( cView );
	cView->forget();
