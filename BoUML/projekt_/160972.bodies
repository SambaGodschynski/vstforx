class ProcessAdapter
!!!236236.cpp!!!	getNumActiveAdapterNodes() : int

	return iNode->getNumActiveChilds();
!!!236364.cpp!!!	createAdapterNode(in name : string = "unnamed") : ProcessAdapterNode

	ProcessAdapterNode *n = new ProcessAdapterNode ( this );
	n->setName (name);
	adapterNodes.push_back ( n );
	graph->addCommand ( Command::Ptr ( new processing::GCmdAddPObject ( graph, n ) ) );
	// mit iNode verbinden:
	n->ProcessorNode::addParent(iNode);
    iNode->ProcessorNode::addChild (n);  
	return adapterNodes.back();
!!!237004.cpp!!!	ProcessAdapter(inout graph : Graph)

	iNode = new NOPNode( "ProcessAdapter InputNode");
	graph->addCommand ( Command::Ptr ( new processing::GCmdAddPObject ( graph, iNode ) ) );
	graph->add ( this );
!!!237516.cpp!!!	~ProcessAdapter()

	ProcessAdapterNodeContainer::iterator it = adapterNodes.begin();
	graph->addCommand ( Command::Ptr ( new processing::GCmdRemovePObject ( graph, iNode ) ) );
	for ( ; it!= adapterNodes.end(); ++it ) {
		graph->addCommand ( Command::Ptr ( new processing::GCmdRemovePObject ( graph, *it ) ) );
	}
