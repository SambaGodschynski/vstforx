class CircuidControl
!!!150732.cpp!!!	initMouseActions() : void

	Graph *graph = getRelatedGraph ( view );
	comMActions = new MouseAction*[NUM_MACTIONS];
	comMActions[MOVE] = new MAMove ();
	comMActions[CONNECT] = new MAConnect( view );
	comMActions[USE] = new MAUse();
	currMouseAction = comMActions[USE];
!!!150860.cpp!!!	spanSelectionRect(in ev : OnMouseDrag) : void

	if ( ev.state == OnMouseDrag::DRAG_START ){
		CRect r = selectionRect->getSize();
		r.left = ev.p.x;
		r.top = ev.p.y;
		r.right = ev.p.x;
		r.bottom = ev.p.y;
		selectionRect->setRect ( r );
		selectionRect->setVisible ( true );
	}
	if ( ev.state == OnMouseDrag::DRAG ){
		CRect r = selectionRect->getSize();
		r.right = ev.p.x;
		r.bottom = ev.p.y;
		selectionRect->setRect ( r );
		selectionRect->setObjectDirty();
	}
	if ( ev.state == OnMouseDrag::DRAG_STOP ){
		selectionRect->setVisible ( false );
		selectionRect->setObjectDirty();
		selection->clear(); // erst mal loeschen
		list<GObject*> oL;
		view->getObjectsInArea ( abs( selectionRect->getSize() ) , oL ); // hole objekte im bereich selRect
		selection->addGObjects (oL);
		view->CView::setDirty();
	}
!!!150988.cpp!!!	dragView(in ev : OnMouseDrag) : void

	if ( ev.state == OnMouseDrag::DRAG ){
		selection->clear();
		view->offsetView ( MyPoint(ev.p) - MyPoint(ev.dragDirection) ); 
	}
!!!151116.cpp!!!	showContextMenu(inout obj : GObject, inout point : CPoint) : void

	menu::MenuEntryList &mList = contextMenu->getMenuEntries();
	if ( obj ) gObjCtrlDirector->getMenuEntryList ( mList, obj );
	else getMenuEntryList ( mList );
	contextMenu->showAt ( point );
!!!151244.cpp!!!	createVSTPluginSubMenu(inout mE : MenuEntryList) : void

	// plugin verz.
	CMenu::Ptr plugMenu = CSubMenu::create( view->getFrame() );
	MenuEntryList &plugMenuL = plugMenu->getMenuEntries();
	
	const list<string> &l = SETTINGS->getPluginDirectoryList();
	// iteriere plugin directories
	if ( l.empty() ) {
		ADD_MENU_TITLE ( plugMenuL, "No VST Directories setted!" );
		ADD_SUB_MENU ( mE, "add_plugin", plugMenu );
		return;
	}
	if ( l.size() == 1 ) {
		createMenuPlugTree ( mE, l.back(), "add_vst_plugin" ); // erst. unter-eintr.
		return;
	}
	ADD_MENU_TITLE ( plugMenuL, "VST Directories:" );
	for ( list<string>::const_iterator it = l.begin(); it!=l.end(); ++it ){
		createMenuPlugTree ( plugMenuL, *it ); // erst. unter-eintr.
	}
	ADD_SUB_MENU ( mE, "add_vst_plugin", plugMenu );
!!!151372.cpp!!!	createMenuPlugTree(inout mE : MenuEntryList, in dir : Path, in submenuTitle : string = string()) : void

	typedef PluginCollection::VSTPluginProxyList ProxyList;
	// hole plugs in dir
	ProxyList proxyList;
	pluginCollection->getProxyList ( dir, proxyList, true );
	if ( proxyList.empty() ) return;
	CMenu::Ptr subDir = CSubMenu::create( view->getFrame() );
	MenuEntryList &subDirL = subDir->getMenuEntries();
	// hole sub. dirs
	PathList dirList; 
	pluginCollection->getSubDirectories(dir, dirList);
	// rek. aufr.
	for ( PathList::const_iterator it = dirList.begin(); it!=dirList.end(); ++it ) {
		CMenu::Ptr subDirMenu = CMenu::create( view->getFrame() );
		createMenuPlugTree ( subDirL, *it );
	}
	// add plugs
	for ( ProxyList::iterator it = proxyList.begin(); it!=proxyList.end(); ++it ) {
		ADD_MENU_LABEL ( 
			subDirL, 
			Path( (*it).filename ).stem(), 
			new CmdAddVSTPlugNode( view, pluginCollection, *it, gObjCtrlDirector ) 
		);
	}
	ADD_SUB_MENU ( mE, ( (submenuTitle.length()==0) ? dir.filename() : submenuTitle ), subDir );
!!!151500.cpp!!!	getMenuEntryList(inout mE : MenuEntryList) : void

	ADD_MENU_TITLE ( mE, "things you can do on this view:" );
	createVSTPluginSubMenu (mE);
	// pr. nodes
	ADD_MENU_LABEL ( mE, "add_volume_node", new CmdCreateVolumeNode ( view, gObjCtrlDirector ) );
	ADD_MENU_LABEL ( mE, "add_channel_split_node", new CmdCreateChannelSplitNode ( view, gObjCtrlDirector ) );
	ADD_MENU_LABEL ( mE, "add_step_node", new CmdCreateStepNode ( view, gObjCtrlDirector ) );
	ADD_MENU_LABEL ( mE, "add_peak_tracker", new CmdCreateVolume2ValueNode ( view, gObjCtrlDirector ) );
	ADD_MENU_LABEL ( mE, "add_adsr_trigger", new CmdCreateADSRTriggerNode ( view, gObjCtrlDirector ) );
	ADD_MENU_LABEL ( mE, "add_free_knob", new CmdCreateFreeGKnob( view, gObjCtrlDirector ) );
	
	// host knobs
	CMenu::Ptr pCM = CSubMenu::create( view->getFrame() );
	MenuEntryList &sec = pCM->getMenuEntries();
	Graph *graph = getRelatedGraph (view);
	//ADD_MENU_TITLE ( sec, "host knobs:" );
	for ( int i=0; i<graph->getNumHostParameter(); ++i ){
		ADD_MENU_LABEL ( sec, "add_host_knob " + MyString(i), new CmdCreateHostGKnob( view, i, gObjCtrlDirector ) );
	}
	ADD_SUB_MENU ( mE, "host_knobs", pCM );
!!!151756.cpp!!!	CircuidControl(inout view : CircuidView, inout vr : ViewRelations)

	initMouseActions();
	view->EventSender<OnMouseClick>::addEventListener ( this );
	view->EventSender<OnMouseDrag>::addEventListener ( this );
	gObjCtrlDirector = new FrontController ( view2model );
	gObjCtrlDirector->setMouseAction ( currMouseAction );
	// Fuege Selection Object ein
	GSelection *g = new GSelection ( view );
	selection = g;
	g->setColor ( ppiGui::grey );
	view->addGObject (g, CircuidView::SELECTION);
	contextMenu = menu::CMenu::create( view->getFrame() );
	contextMenu->EventSender<OnMouseLeave>::addEventListener ( this );
	selectionRect = new GRect ( view );
	view->addGObject ( selectionRect );
	selectionRect->setWidth (1);
	selectionRect->setLineStyle ( kLineOnOffDash );
	selectionRect->setDrawStyle ( kDrawStroked );
	selectionRect->setVisible ( false );
	pluginCollection = PluginCollection::getPluginCollection();
!!!151884.cpp!!!	~CircuidControl()

	for ( int i=0; i<NUM_MACTIONS; i++ ) delete comMActions[i];
	delete comMActions;
	delete gObjCtrlDirector;
!!!152012.cpp!!!	eventHandler(inout src : void, in ev : OnMouseClick) : void

	selection->clear();
	selection->setObjectDirty();
	if ( ev.btn == kRButton ) { // Kontext Menu aufrufen
		showContextMenu ( ev.src, ev.p );
		return;
	}
	if ( ev.btn == kLButton ){
		if ( contextMenu->isVisible() ) {
			contextMenu->hide();
			view->CView::setDirty();
		}
	}
!!!152140.cpp!!!	eventHandler(inout src : void, in ev : OnMouseDrag) : void

	if ( ev.btn == kLButton && currMouseAction != comMActions [MOVE] ) spanSelectionRect( ev );
	if ( ev.btn == kMButton || currMouseAction == comMActions [MOVE] ) dragView( ev );
!!!152268.cpp!!!	selectFile() : string
 //TODO : Voruebegehende Loesung
	VstFileType vstPlugType ("VST Plugin File", 0, "dll");
	VstFileSelect vstFileSelect;
	memset (&vstFileSelect, 0, sizeof (VstFileSelect));
	vstFileSelect.command     = kVstFileLoad;
	vstFileSelect.type        = kVstFileType;
	strcpy (vstFileSelect.title, "Select VST Plug File");
	vstFileSelect.nbFileTypes = 1;
	vstFileSelect.fileTypes   = &vstPlugType;
	vstFileSelect.returnPath  = new char[1024];
	vstFileSelect.initialPath = 0;
	vstFileSelect.future[0] = 1;	// utf-8 path on macosx
	CFileSelector cFile( NULL ); 
	cFile.run (&vstFileSelect);
	string ret(vstFileSelect.returnPath);
	delete []vstFileSelect.returnPath;
	if (vstFileSelect.initialPath) delete []vstFileSelect.initialPath;
	return ret;
!!!152524.cpp!!!	initView() : void

	Graph *g = getRelatedGraph(view);
	// * !! Output ist das ding oben ( schon tausendmal verwechselt )
	GOutputNode *out = new GOutputNode ( view, RESOURCE.MAIN_OUTPUT_NODE );
	gObjCtrlDirector->registerObject ( out, g->getStartNode() );
	out->offset ( ( SETTINGS->WINDOW_WIDTH>>1 ) - ( out->getSize().getWidth()>>1 ), 50);
	view->addGObject (out);
	// * !! Input ist das ding unten
	GInputNode *in = new GInputNode ( view, RESOURCE.MAIN_INPUT_NODE );
	gObjCtrlDirector->registerObject ( in, g->getEndNode() );
	in->offset ( 
		( SETTINGS->WINDOW_WIDTH>>1 ) - ( in->getSize().getWidth()>>1 ), SETTINGS->WINDOW_HEIGHT - 100 
	);
	view->addGObject (in);

!!!152652.cpp!!!	eventHandler(inout scr : void, in ev : MouseContextChanged) : void

	switch ( ev.id ){
		case MToolBox::tBtnUse :
			currMouseAction = comMActions [USE];
			break;
		case MToolBox::tBtnConnect :
			currMouseAction = comMActions [CONNECT];
			break;
		case MToolBox::tBtnMove :
			currMouseAction = comMActions [MOVE];
			break;
	}
	gObjCtrlDirector->setMouseAction ( currMouseAction );
!!!152780.cpp!!!	eventHandler(inout scr : void, in ev : OnMouseLeave) : void

	contextMenu->hide();
	view->CView::setDirty();
!!!152908.cpp!!!	save(inout ar : oArchive) : void

	// serialisierbare objekte sammeln:
	list < GObject* > objs;
	CircuidView::GObjectStageBuffer::iterator it = view->gObjectBuffer.begin();
	LOG_ASSERT ( it != view->gObjectBuffer.end() );
	for ( ; it != view->gObjectBuffer.end(); ++it ){ // druchlaufe alle GObjects auf der View
		Serializable *obj = dynamic_cast< Serializable* > ( (*it).second );
		if (!obj) continue;
		objs.push_back ( (*it).second );
	}
	// serialisieren:
	ar<<objs;
	TOLOG ( MyString( objs.size() ) + " objects saved.");
!!!153036.cpp!!!	load(inout ar : iArchive) : void

	// serialisieren:
	list < GObject* > objs;
	ar>>objs;
	list < GObject*>::iterator it = objs.begin();
	for ( ;it!=objs.end(); ++it ){
		view->addGObject ( *it, (*it)->getZPos() ); 
	}
	TOLOG ( MyString( objs.size() ) + " objects loaded.");
