class GKnob
!!!174796.cpp!!!	load(inout ar : iArchive, in version : uint) : void

	ar >> boost::serialization::base_object<GObject>(*this);
	string upper, lower;
	ar >> upper;
	ar >> lower;
	setHeader( upper );
	setDisplay ( lower );
	float value;
	ar >> value;
	setValue( value );
