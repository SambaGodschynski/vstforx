!!!175564.cpp!!!	GKnob(inout parent : CircuidView, inout knob : CAnimKnob)

	name = "Knob";
	gFlag = new GFlag ( parent, this );
	subObjects.push_back ( gFlag );
!!!176332.cpp!!!	createNewCAnimKnob(in resId : long, in subPix : int) : CAnimKnob

	CBitmap *bmp = new CBitmap ( resId );
	CRect size ( 0, 0, bmp->getWidth(), bmp->getHeight()/subPix );
	CAnimKnob *neu = new CAnimKnob ( size, NULL, 0, subPix, bmp->getHeight()/subPix, bmp, CPoint() );
	bmp->forget();
	return neu;
