class GChannelSplitNode
!!!168780.cpp!!!	GChannelSplitNode(inout view : CircuidView)

	name = "Channel_Split_Node";
	skin = new CBitmap (RESOURCE.VSTPLUG_NODE);
	bBox = CRect ( 0,0, skin->getWidth(), skin->getHeight() );
	focus = CPoint ( skin->getWidth()>>1, skin->getHeight()>>1 );
	radius = skin->getWidth()>>1;
	focus = CPoint (bBox.width()>>1, bBox.height()>>1);
!!!168908.cpp!!!	render(inout cc : CDrawContext) : void

	skin->draw ( cc, bBox );
!!!169036.cpp!!!	~GChannelSplitNode()

	delete skin;
