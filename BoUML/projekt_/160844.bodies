class CmdCreateProcessorNode
!!!207948.cpp!!!	create() : void

	Graph *graph = getRelatedGraph ( cView );
	CPoint point; cView->getMouseLocation (point);
	// Graph Objekt erzeugen 
	Adapter *adapter = new Adapter(graph);
	// GObjekt erzeugen 
	GPrNode *gProcessor = new GPrNode ( cView );
	// GObject registrieren
	ctrl->registerObject ( gProcessor, adapter );
	// an Mauspos. verschieben
	gProcessor->moveTo ( point );
	// GIONodes Erzeugen
	gProcessor->createIONodes( 1, numPANodes, ins, outs );
	// GObject: Eingangsknoten
	GInputNode  *in = ins.at(0);
	// registriere GObject
	ctrl->registerObject ( in, adapter->getInputNode() );
	in->setName ( gProcessor->getName() + "::input" );
	for ( int i=0; i<numPANodes; i++ ) {
		// Ausgangsknoten gProcessor
		GOutputNode *out = outs.at(i);
		ctrl->registerObject ( out, adapter->getNode(i) );
		out->setName ( gProcessor->getName() + "::output" + MyString(i+1) );
	}
	newGPr = gProcessor;
	newPrA = adapter;
