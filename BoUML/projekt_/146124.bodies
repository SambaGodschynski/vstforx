class CMenuScrollSwitch
!!!163148.cpp!!!	CMenuScrollSwitch(inout parent : CMenu)

	CBitmap *bmp = new CBitmap ( RESOURCE.MENU_ROCKER );
	CRect sz ( 0, 0, bmp->getWidth(), bmp->getHeight()/3 );
	rSwitch = new CRockerSwitch ( sz, this, 0, 10, bmp, CPoint() );
	bmp->forget();
	setViewSize ( sz );
	setMouseableArea ( sz );
!!!163404.cpp!!!	~CMenuScrollSwitch()

	delete rSwitch;
!!!163660.cpp!!!	mouse(inout cc : CDrawContext, inout p : CPoint, in btn : long) : void

	ppiGui::GCView *hack = (ppiGui::GCView*)rSwitch;
	hack->setFrame ( parent->getFrame() );
	hack->mouse(cc, p, btn);
