class MainCtrl
!!!189900.cpp!!!	MainCtrl(inout size : CRect, inout pSystemWindow : void, inout pEditor : void)

	toolBx = new MToolBox ( this );
!!!190028.cpp!!!	~MainCtrl()

	delete toolBx;
!!!190156.cpp!!!	update(inout cc : CDrawContext) : void

	CFrame::update ( cc );
	CPoint p;
	cc->getMouseLocation(p);
	listenersChanged = true;
	while ( listenersChanged ) {
		listenersChanged = false;
		MouseMotionListenerList::iterator it = mMotionListeners.begin();
		for ( ;it!=mMotionListeners.end(); ++it  ) {  
			(*it)->mouseMoveEventHandler ( cc, p );
			if ( listenersChanged ) break;
		}
	}
