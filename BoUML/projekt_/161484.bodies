class CmdCreateVolume2ValueNode
!!!208972.cpp!!!	_execute() : void

	create<GPeakTracker, PeakTracker, 0>();
	Graph *graph = getRelatedGraph ( cView );
	// registriere PAdapter
	PeakTracker *vol = (PeakTracker*) newPrA;
	// unsichtbare verbindung:
	graph->addCommand ( Command::Ptr ( 
		new processing::GCmdConnectProcessorNodes ( graph, graph->getEndNode(), newPrA->getNode(0) ) ) 
	);
	// Output Knob
	GKnob *knob = new GPassiveKnob ( cView );
	ctrl->registerObject ( knob, vol->getOutParameter() );
	// knob flag:
	knob->setHeader ( vol->getOutParameter()->getName() );
	knob->setDisplay ( vol->getOutParameter()->getDisplay() );
	// knob pos.
	CPoint p (newGPr->getPos());
	p.offset ( newGPr->getSize().width(), -newGPr->getSize().height() ); 
	knob->moveTo ( p );
	cView->addGObject ( knob );
	cView->addGObject ( newGPr );
	// Knob Connection
	GConnection *gc = new GConnectionPrPa ( cView, newGPr, knob );
	ctrl->registerObject ( gc, NULL );
	cView->addGObject ( (GObject*)gc, CircuidView::CONNECTIONS);
	list<GConnection*> l;
	newGPr->addIONodesOnView( ins, outs, l );
	// connections registr.
	for ( list<GConnection*>::iterator it = l.begin(); it!=l.end(); ++it ) {
		ctrl->registerObject ( *it );
	}
	cView->CView::setDirty();
