class GProcessorNode
!!!203852.cpp!!!	createInNode(inout p : CPoint) : GInputNode

	GInputNode *in = new GInputNode ( parentView, RESOURCE.VSTPLUG_INPUT );
	in->moveTo ( p );
	return in;
!!!203980.cpp!!!	createOutNode(inout p : CPoint) : GOutputNode

	GOutputNode *out = new GOutputNode ( parentView, RESOURCE.VSTPLUG_OUTPUT );
	out->moveTo ( p );
	return out;
!!!204364.cpp!!!	createIONodes(in numInputs : int, in numOutputs : int, inout createdInNodes : GProcessorNode::InputNodeContainer, inout createdOutNodes : GProcessorNode::OutputNodeContainer) : void

	// Input Nodes erstellen---------------------------------------
	CPoint p = getPos();
	p.offset ( 0, - bBox.height() );
	CPoint u = p; // start
	float d = 100.0/(float)numInputs;
	for ( int i=0; i<numInputs/2; ++i ) { // eine haelfte nach links faechern
		int f = numInputs/2 - i;
		rotate (p, f*-d, getPos() );
		createdInNodes.push_back ( createInNode(p) );
		p = u;
	}
	if (numInputs%2==1) createdInNodes.push_back ( createInNode(p) ); // mitte
	for ( int i=0; i<numInputs/2; ++i ) { // andere haelfte nach rechts faechern
		int f = numInputs/2 - i;
		rotate (p, f*d, getPos() );
		createdInNodes.push_back ( createInNode(p) );
		p = u;
	}
	// Output Nodes erstellen---------------------------------------
	p = getPos();
	p.offset ( 0, bBox.height() );
	u = p; // start
	d = 100.0/(float)numOutputs;
	for ( int i=0; i<numOutputs/2; ++i ) { // eine haelfte nach links faechern
		int f = numOutputs/2 - i;
		rotate (p, f*d, getPos() );
		createdOutNodes.push_back ( createOutNode(p) );
		p = u;
	}
	if (numOutputs%2==1)createdOutNodes.push_back ( createOutNode(p) ); // mitte
	for ( int i=0; i<numOutputs/2; ++i ) { // andere haelfte nach rechts faechern
		int f = numOutputs/2 - i;
		rotate (p, f*-d, getPos() );
		createdOutNodes.push_back ( createOutNode(p) );
		p = u;
	}
!!!204492.cpp!!!	addIONodesOnView(inout ins : GProcessorNode::InputNodeContainer, inout outs : GProcessorNode::OutputNodeContainer, inout createdConnections : list<GConnection*>) : void

	GConnection *con = NULL;
	InputNodeContainer::iterator iit = ins.begin();
	for ( ; iit!=ins.end(); ++iit ) { 
		con = new GConnectionPrIn ( parentView, this, *iit );
		createdConnections.push_back ( con );
		parentView->addGObject ( *iit );
		parentView->addGObject ( (GObject*)con, CircuidView::CONNECTIONS );
	}
	OutputNodeContainer::iterator oit = outs.begin();
	for ( ; oit!=outs.end(); ++oit ) {  
		con = new GConnectionPrOut ( parentView, this, *oit );
		createdConnections.push_back ( con );
		parentView->addGObject ( *oit );
		parentView->addGObject ( (GObject*)con, CircuidView::CONNECTIONS );
	}
