class GProcessorNodeController
!!!186700.cpp!!!	unregisterObject(inout gObj : GObject, inout pObj : PObject) : void

	GProcessorNode *node = (GProcessorNode*) gObj;
	CircuidView *view = node->getParentView();
	Graph *g = getRelatedGraph( view );
	// entferne pobject
	g->addCommand ( Command::Ptr ( new GCmdRemovePObject ( g, pObj ) ) );
!!!186956.cpp!!!	createMenu(inout obj : GObject, inout mL : MenuEntryList, inout toPrC : MenuEntryList = NULL) : void

	PObject *mObj = frntCtrl.getViewRelations().get<PObject> ( obj );
	string name = obj->getName();
	ADD_MENU_TITLE  ( mL, name );
	if (toPrC) {
		menu::MenuEntryList::iterator it = toPrC->begin();
		for ( ; it!=toPrC->end(); ++it ) mL.push_back ( *it );
	}
	ADD_MENU_LABEL ( mL, "remove_" + name, new CmdRemoveGObject ( obj->getParentView(), obj ) );
	HasParameter *hP = dynamic_cast<HasParameter*> ( mObj );
	if ( !hP ) return;
	CMenu::Ptr sub = menu::CSubMenu::create ( obj->getParentView()->getFrame() );
	MenuEntryList &subEntr = sub->getMenuEntries();
	ADD_MENU_TITLE ( subEntr, "parameter :" ); 
	hasParameterToMenuEntryList ( hP, subEntr, (GProcessorNode*)obj, &frntCtrl, 0 );
	ADD_SUB_MENU ( mL, name + " parameter", sub );
