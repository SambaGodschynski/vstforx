class ChannelSplitAdapter
!!!217548.cpp!!!	processAdapter(inout frC : FrameContainer) : void

	if (lNode->isActive()) { processL (frC.top()); frC.pop(); }
	if (rNode->isActive()) { processR (frC.top()); frC.pop(); }
!!!217676.cpp!!!	processL(inout fr1 : Frame) : void

	if ( !lNode->isActive() ) return;
	VstInt32 i = fr1->frameSize;
	VstNumber *c = fr1->data[0];
	while ( --i >= 0 ){
		*(c++) = 0.0f;
	}
	lNode->pushFrame( fr1 );
!!!217804.cpp!!!	processR(inout fr1 : Frame) : void

	if ( !rNode->isActive() ) return;
	VstInt32 i = fr1->frameSize;
	VstNumber *c = fr1->data[1];
	while ( --i >= 0 ){
		*(c++) = 0.0f;
	}
	rNode->pushFrame( fr1 );
!!!217932.cpp!!!	ChannelSplitAdapter(inout graph : Graph)

	rNode = createAdapterNode();
	lNode = createAdapterNode();
	rNode->setName ("ChannelSplitNode_R");
	lNode->setName ("ChannelSplitNode_L");
