class GObjectController
!!!180940.cpp!!!	removeConnectedComponents(inout gObj : GObject) : void

	list<GObject*> l;
	getConnectedComponents ( gObj, l );
	list<GObject*>::iterator it = l.begin();
	CircuidView *view = gObj->getParentView();
	for ( ; it!=l.end(); ++it ) {
		view->removeGObject ( *it );
		delete *it;
	}
!!!181324.cpp!!!	registerObject(inout vObj : GObject, inout mObj : PObject) : void

	vObj->EventSender<OnMouseClick>::addEventListener ( this );
	vObj->EventSender<OnMouseDrag>::addEventListener ( this );
	vObj->EventSender<OnRemove>::addEventListener ( this );
!!!181708.cpp!!!	eventHandler(inout src : void, in ev : OnMouseClick) : void

	mAction->onMouse ( ev );
!!!181836.cpp!!!	eventHandler(inout src : void, in ev : OnMouseDrag) : void

	mAction->onMouse ( ev );
!!!181964.cpp!!!	eventHandler(inout src : void, in ev : OnRemove) : void

	if ( dynamic_cast <GProcessorNode*>(ev.gObject) || dynamic_cast <GConnectionPaPa*>(ev.gObject) ) {
		// hier exitstieren evtl. weitere zugehoerige obj.
		removeConnectedComponents (ev.gObject);
	}
	// connections entf.
	list<GConnection*> l;
	findConnectionsOnObject ( ev.gObject, l );
	list<GConnection*>::iterator it = l.begin();
	for ( ; it!=l.end(); ++it ) { // connections loeschen
		ev.gObject->getParentView()->removeGObject(*it); //connection aus view entfernen
		// Romanes Eunt Domus !
		delete *it; 
	}
	frntCtrl.unregisterObject ( ev.gObject ); /* entfernt object aus viewrelations und ruft										 
												 unregisterObject() im zugeordneten controller auf */
!!!182348.cpp!!!	findConnectionsOnObject(inout obj : GObject, inout cL : list<GConnection*>) : void

	// :: Suche GConnection (nicht gerade die beste methode aber ausreichend) ::
	GObjectContainer l;
	// hole alle connections auf stage:
	obj->getParentView()->getGObjectsAtStage ( l, CircuidView::CONNECTIONS );
	GObjectContainer::iterator it = l.begin();
	for ( ; it!=l.end(); ++it ) {
		GConnection *gc = dynamic_cast <GConnection*> ( *it );
		if (!gc) continue;
		if (  gc->getObjectA() != obj && gc->getObjectB() != obj  ) continue;
		cL.push_back ( gc );
	}
!!!182476.cpp!!!	getConnectedComponents(inout gObj : GObject, inout retL : list<GObject*>) : void

	list<GConnection*> l;
	findConnectionsOnObject ( gObj, l );
	list<GConnection*>::iterator it = l.begin();
	for ( ; it!=l.end(); ++it ) { 
		// connection dessen gegnstck. an processor gebunden ist
		if ( dynamic_cast<GConnectionPrPa*>  ( *it ) || 
			 dynamic_cast<GConnectionCoPa*>  ( *it ) ||  
			 dynamic_cast<GConnectionPrIn*>  ( *it ) ||
			 dynamic_cast<GConnectionPrOut*> ( *it )  
		) {
			// gegenuebeliegendes obj. finden :
			GObject *opp = ( gObj == (*it)->getObjectA() ) ? (*it)->getObjectB() : (*it)->getObjectA();
			retL.push_back ( opp );
		}
	}
