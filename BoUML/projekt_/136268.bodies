class Settings
!!!149196.cpp!!!	Settings()

	using namespace boost::algorithm;
	loadConfigFile();
	string name = NAME; to_lower(name);
	plugCollectionDumpFile = name + "_plugin_db_dump";
!!!149324.cpp!!!	loadConfigFile() : void

	ifstream f;
	try {
		f.open ( CONFIG_FILE.c_str(), ios::app );
		while ( !f.eof() ) {
			string str = getConfigLine (f);
			if ( str.length() > 0 )
				pluginDirectories.push_back (str);
		}
	} catch (...) {
		f.close();
		return;
	}
	f.close();
!!!149452.cpp!!!	saveConfigFile() : void

!!!149580.cpp!!!	getSettings() : Settings::Ptr

	if (!settings) settings = Settings::Ptr ( new Settings() );
	return settings;
!!!149708.cpp!!!	init(inout resource : Settings::Resource, inout hInfo : Settings::HostInformation) : void

	getSettings()->resource = resource;
	getSettings()->hInfo = hInfo;
!!!150348.cpp!!!	versionToString() : string

	char bff[255];
#ifdef NDEBUG
	sprintf ( &bff[0],"%.3fr",  PPI_VERSION / 1000.0f );
#else 
	sprintf ( &bff[0],"%.3fd",  PPI_VERSION / 1000.0f );
#endif
	return string (bff);
