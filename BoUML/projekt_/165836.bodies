class PeakTracker
!!!223948.cpp!!!	addToWindow(in n : VstNumber) : void

	average += fabs(n);
	if ( counter++ >= N ) {
		counter = 0;
		average/=(VstNumber)N;
		*out = average + *offset;
		average = 0.0f;
	}
!!!224204.cpp!!!	processAdapter(inout frC : FrameContainer) : void

	Frame *frame = frC.top(); frC.pop();
	VstInt32 i = frame->frameSize;
	VstNumber *r = frame->data[0];
	VstNumber *l = frame->data[1];
	VstNumber v;
	while ( --i >= 0 ){
		v = ( *(r) + *(l) )/2.0f;
		addToWindow(v);
		*(r++) = 0.0f;
		*(l++) = 0.0f;
	}
	vNode->pushFrame(frame);
