frx.scripts
#include <scripts/LuaFrxObject.hpp>

/**
 * @brief This class represents a parameter (view) object.
 * @alias frx.view.Parameter
 * @extends @see frx.view.Object
 * @version 1.0.5
 */
class LuaFrxParameterBase extends LuaFrxObject {
      /**
       * @brief Set the parameter value.
       * @param the value (0..1)
       * @version 1.0.5
       */
      void setValue(float value);
     /**
       * @return the parameter value.
       * @version 1.0.5
       */
      float getValue();
     /**
      * @brief Adds a listener which will be called when 
      *        the parameter value was changed.
      * @param a valid lua expression
      * @version 1.0.52
      */
      void addListener(string expr);
}




