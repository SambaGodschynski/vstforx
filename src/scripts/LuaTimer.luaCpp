frx.scripts

/**
 * @brief A timer class. To create an object of this class use @see frx.Frx:addTimer() 
 * @alias frx.Timer
 * @version 1.0.5
 */
class LuaTimerBase extends sambag.lua.ALuaObject {
     /**
      * @brief starts the timer
      */
      void start();
      /**
       * @brief stops the timer
       */
      void stop();
}




