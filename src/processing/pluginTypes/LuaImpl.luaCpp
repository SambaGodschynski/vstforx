frx.processing

#include <processing/pluginTypes/LuaDefs.hpp>

/**
 * @alias Plugin
 * @brief 
 * <h4>Setting up a Plugin</h4>
 * A Lua Plugin is a Lua script file which (if is valid) is treated as any other plugin by VSTForx. That means
 * it will be recognized by the plugin scanner. So the first step to create a Lua plugin sould be to create 
 * a *.lua textfile in your VST plugin folder. 
 * Furthermore your script needs some initial informations:
 * <h5>Setup Table: "gpConfig"</h5>
 * Here you can config your plugin. 
 * <pre>
 * --setup table example <br>
 * gpConfig = { <br>
 * type="frx_lua_plugin",          -- this field is required<br>
 * name="Simple Delay"             -- the plugin name, <br>
 * author="Samba Godschynski",     -- optional information<br>
 * numInChannels=2                 -- the number of input channels (two channels are applied to one node in vstforx), <br>
 * numOutChannels=2,               -- the number of output channels<br>
 * info="A simple example script." -- optional <br>
 * } <br>
 * </pre>
 * <div class="alert">Note: Since VSTForx couldn't handle changing the I/O configuration at runtime you have to re-add your plugin after
 * changing numInChannels or numOutChannels.</div>
 * <h5>Parameter Setup: "gpParameterSetup"</h5>
 * The parameter setup table has two functions:
 * <ul>
 *   <li>configure the plugin parameter setup by using its (name, value) pairs</li>
 *   <li>update its values after a parameter changed</li>
 * </ul>
 * Note that the parameter value access is read only, for changing a parameter value use @see setParameterValue().
 * <pre>
 * --parameter setup example
 * gpParameterSetup = { <br>
 * parameter1 = 0.1, <br>
 * parameter2 = 0.2, <br>
 * parameter3 = 0.3  <br>
 * } <br>
 * </pre>
 * Now your plugin is ready to go.
 * <h4>Messages</h4> 
 * <h5>Script -> VSTForx</h5>
 * Requests to VSTForx are handled by an object of this @see frx.Plugin class which can be found in the global @see frx.Frx table:
 * <pre>
 * -- accessing the plugin object example <br>
 * frx.plug:log("Hello")
 * </pre>
 * <h5>VSTForx -> Script</h5>
 * Information between VSTForx and your script are exchanged by so called callback functions. To distinguish them from
 * regular lua functions, all callback functions have a "lc" (<strong>l</strong>ua <strong>c</strong>allback) prefix.
 * <h6>Callback Functions</h6>
 * <dl>
 * <dt>lcInit()</dt>
 * <dd>called when loading the plugin</dd>
 * <dt>lcOnSave()</dt>
 *   <dd>called when VSTForx is about to save the plugin state. 
 *       Now it's a good time to call @see setPersistUserData()
 *   </dd>
 * <dt>lcOnLoad()</dt>
 *   <dd>called when VSTForx is about to load the plugin state. 
 *       You can restore your previous saved data using @see getPersistUserData()
 *   </dd>
 * <dt>lcProcess(numSamples)</dt>
 * <dd>
 *	This is the heart of the plugin. All input and output processing happens now.
 * 	see @getChannel() and @setChannel()
 * </dd>
 * <dt>lcProcessMidi(messages)</dt>
 *   <dd>
 *     Will be called when a midi message receives. The messages have following format:
 *     <pre>
 *       { {deltaFrames=0, size=0, data={}}, ... }
 *     </pre>
 *   </dd>
 * <dt>lcSetAudioConfig(blockSize, sampleRate)</dt>
 *   <dd>
 *     Whenever your DAW changes its configuration this function will be called. Use this
 *     to configure buffers etc.
 *   </dd>
 * </ul>
 * @version 1.0.5
 */
class LuaImplBase extends sambag.lua.ALuaObject {
      /**
       * @brief Sends a log message to the plugin editor console.
       * @hiddenParam mixed_values ... 
       * @version 1.0.5
       */
      void log();
      /**
       * @brief Sends a log warning message to the plugin editor console.
       * @hiddenParam mixed_values ...
       * @version 1.0.5
       */
      void logWarn();
      /**
       * @brief Sends a log error message to the plugin editor console.
       * @hiddenParam mixed_values ...
       * @version 1.0.5
       */
      void logErr();
      /**
       * @brief Sends a log trace message to the plugin editor console.
       * @hiddenParam mixed_values ...
       * @version 1.0.5
       */
      void logTrace();
      /**
       * @brief Sends a midi message to VSTForx.
       * @hiddenParam sequence msg
       * @param the midi byte message
       * @version 1.0.5
       */
      void sendMidi();
      /**
       * @return The input data of the given channel.
       * @returnType sequence
       * @param the channel number
       * @note this function can only be called during the lcProcess callback 
       * @version 1.0.5
       */
      User<LuaFrames> getChannel(int nb);
      /**
       * @brief Calculates fft data according to this algorithm: 
       * <a href="http://fftguru.com/fftguru.com.tutorial.pdf">fftguru.com</a>
       * @return the fft data output sequence
       * @hiddenParam sequence r
       * @hiddenParam sequence i     
       * @param the r input sequence
       * @param the i input sequence	
       * @returnType sequence
       * @version 1.0.5
       */
      User<FFTData> fft();
      /**
       * @brief Set the channel output data.
       * @hiddenParam int nb
       * @hiddenParam sequence data
       * @param the channel number
       * @param the channel data sequence
       * @note this function can only be called during the lcProcess callback 
       * @version 1.0.5
       */
      void setChannel();
      /**
       * @return the current position in audio samples
       * @version 1.0.5
       */
      double getSamplePos();
      /**
       * @return the last bar start position, in quarter note 
       * @version 1.0.5
       */
      double getBarStartPos();
      /**
       * @return musical position, in quarter note (1.0 equals 1 quarter note). 
       * @version 1.0.5
       */
      double getPpqPos();
      /**
       * @return time signature numerator (e.g. 3 for 3/4).
       * @version 1.0.5
       */
      int getTimeSigNumerator();
      /**
       * @return time signature denominator (e.g. 4 for 3/4).
       * @version 1.0.5
       */
      int getTimeSigDenominator();
      /**
       * @return the current tempo in BPM
       * @version 1.0.5
       */
      double getTempo();
      /**
       * @return true if the transport of the main DAW is playing
       * @version 1.0.51
       */
       bool transportIsPlaying();
      /**
       * @brief Set the parameter value
       * @param the parameter id
       * @param the parameter value (0..1)
       * @version 1.0.5
       */
      void setParameterValue(string id, float value);
      /**
       * @brief Set the parameter display text.
       * @param the parameter id
       * @param the text
       * @version 1.0.5
       */
      void setParameterDisplay(string id, string txt);
      /**
       * @return the parameter value
       * @param the parameter id
       * @version 1.0.5
       */
      float getParameterValue(string id);
      /**
       * @return the parameter display text.
       * @param the parameter id
       * @version 1.0.5
       */
      string getParameterDisplay(string id);
      /**
       * @brief Adds a listener to a parameter.
       * @param the parameter id
       * @param a callback function which accepts a string (the id) and a float (the value) argument
       * <pre>
       * function onParameterChanged(id, value) <br>
       *   frx.plug:log(id, value) <br>
       * end <br>
       * frx.plug:addParameterListener("param1", "onParameterChanged")
       * </pre>
       *
       */
      void addParameterListener(string id, string function); 
      /**
       * @brief Removes a parameter listener. (@see addParameterListener())
       * @param the parameter id
       * @param the registered callback function
       */
      void removeParameterListener(string id, string function); 
      /**
       * @return the persist user data for a key.
       * @returnType sequence
       * @param the key
       * @note there is currently an issue here: it's not guaranteed that the data table
       * entries are in the same order as saved. (see <a href="http://issues.vstforx.de/view.php?id=488">#488</a>)
       * @version 1.0.5
       */
      ManuallyReturn<1> getPersistUserData(string key);
      /**
       * @brief Set persist user data for a given key.
       * @hiddenParam string key
       * @hiddenParam sequence data
       * @param the key
       * @param the data value sequence e.g {"first value","second value", 100}
       * @version 1.0.5
       */
      void setPersistUserData();
}



