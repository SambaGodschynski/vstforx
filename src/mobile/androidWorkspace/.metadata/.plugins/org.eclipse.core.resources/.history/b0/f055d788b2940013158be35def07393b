package frx.com.vstforxmobile;

import java.util.ArrayList;
import java.util.Iterator;

import org.json.JSONException;
import org.json.JSONObject;

public class SessionPOD {
	public String name;
	static final public class Slider {
		public String name;
		public double value;
	}
	public Slider sliders[];
	/**
	 * 
	 * @param json
	 * @return
	 * @throws JSONException 
	 */
	static public SessionPOD[] createSessions(String json) throws JSONException {
		return createSessions(new JSONObject(json));
	} 
	/**
	 * 
	 * @param json
	 * @return
	 * @throws JSONException 
	 */
	static public SessionPOD[] createSessions(JSONObject json) throws JSONException {
		ArrayList<SessionPOD> res = new ArrayList<SessionPOD>(json.length());
		Iterator<String> it = json.keys();
		while(it.hasNext()) {
			SessionPOD obj = new SessionPOD();
			obj.name = it.next();
			obj.sliders = createSliders(json.getJSONObject(obj.name)); 
			res.add(obj);
		}
		return res.toArray(new SessionPOD[0]);
	} 
	
	static public Slider[] createSliders(JSONObject json) throws JSONException {
		ArrayList<Slider> res = new ArrayList<Slider>(json.length());
		Iterator<String> it = json.keys();
		while(it.hasNext()) {
			Slider obj = new Slider();
			obj.name = it.next();
			obj.value = json.getDouble(obj.name);
			res.add(obj);
		}
		return res.toArray(new Slider[0]);
	}
}
